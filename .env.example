# ==========================================
# WORKLINK ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (Production Neon PostgreSQL)
# Provided automatically by Neon integration or dashboard
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# 2. AUTHENTICATION & SECURITY
# 32+ character secret for AES-GCM session token signing & encryption
AUTH_SECRET=generate_with_openssl_rand_hex_32

# 3. PUBLIC APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. PRIVATE DOCUMENT STORAGE (Optional / Production S3 or Cloudflare R2)
# If left empty, local secure private storage (private_storage/) is used.
STORAGE_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# 5. PAYMENT GATEWAY (Optional - Default: Sandbox Test Simulation)
# If STRIPE_SECRET_KEY is empty, the application runs in clearly labeled Sandbox Test mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# PAYFAST_MERCHANT_ID=
# PAYFAST_SECURED_KEY=

# 6. EMAIL NOTIFICATIONS (Optional - Direct SMTP provider)
# If left empty, persistent in-app notifications are stored in Neon Postgres.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="WorkLink <notifications@worklink.com>"

# 7. AI RECOMMENDATIONS (Optional - Future semantic embeddings)
# Current version uses transparent rule-based database ranking.
# OPENAI_API_KEY=
