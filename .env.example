# WorkLink Environment Configuration

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/worklink?schema=public"

# Authentication & Sessions
JWT_SECRET="worklink-super-secret-jwt-key-production-ready-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External Integrations (Documented for live production deployment)
# Stripe test/live mode keys
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Email service (e.g., Resend or Sendgrid)
# EMAIL_SERVER_USER="resend"
# EMAIL_SERVER_PASSWORD="re_..."
# EMAIL_FROM="notifications@worklink.com"

# Cloud Storage (AWS S3 or Cloudinary)
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
